# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Cloudflare R2 (see docs/R2_SETUP.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ORIGINALS=sale-enzo-originals
R2_BUCKET_MEDIA=sale-enzo-media
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://media.example.com

# Background removal: imgly (on-device, WASM/WebGPU) | replicate (BiRefNet, server)
NEXT_PUBLIC_BG_PROVIDER=imgly
REPLICATE_API_TOKEN=
