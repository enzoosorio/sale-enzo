# Public site origin for canonicals, sitemap, robots, Open Graph and JSON-LD.
# No trailing slash. Falls back to https://sale-enzo.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=https://sale-enzo.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
# Model used by "Verificar en la web" (needs web_search support); falls back to OPENAI_CHAT_MODEL
OPENAI_WEB_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Cloudflare R2 (see docs/R2_SETUP.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ORIGINALS=sale-enzo-originals
R2_BUCKET_MEDIA=sale-enzo-media
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://media.example.com

# Background removal runs as a chain: the first provider whose cutout passes the quality gate wins.
# NEXT_PUBLIC_BG_PROVIDER picks the FIRST one: imgly (on-device, WASM/WebGPU) | replicate (BiRefNet, server).
# Replicate is the automatic fallback; leave its vars empty to run on-device only (failed cutouts are flagged).
NEXT_PUBLIC_BG_PROVIDER=imgly
REPLICATE_API_TOKEN=
# Version hash of the BiRefNet model on Replicate (required for the fallback)
REPLICATE_BG_VERSION=

# Wrinkle smoothing ("planchado") on demand: gemini | photoroom
RETOUCH_PROVIDER=gemini
# Gemini API key from Google AI Studio (billing enabled; a Gemini app subscription does not cover the API)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# PhotoRoom Image Editing API (Plus plan; the sandbox key is free but watermarked)
PHOTOROOM_API_KEY=

# Checkout: keep disabled until the account, webhook and delivery options are verified.
MERCADO_PAGO_CHECKOUT_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COLLECTOR_ID=
SITE_URL=
CHECKOUT_CRON_SECRET=
CART_MERGE_SECRET=

# WhatsApp: every purchase is closed by chat. Country code + number, digits only
# (format 51XXXXXXXXX, e.g. 51987654321). Leave empty to hide the WhatsApp buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=
